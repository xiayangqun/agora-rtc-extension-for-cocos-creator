{
    "package_version": 2,
    "version": "1.0.0",
    "name": "agora-rtc-extension-for-cocos-creator",
    "description": "i18n:agora-rtc-extension-for-cocos-creator.description",
    "main": "./dist/main.js",
    "author": "Cocos Creator",
    "editor": ">=3.8.8",
    "scripts": {
        "build": "tsc -b",
        "watch": "tsc -w",
        "predownload": "node scripts/predownload.js",
        "predownload:clear": "node scripts/predownload.js --clear",
        "test:predownload": "node scripts/test-predownload-utils.js",
        "test:ios-build-config": "node scripts/test-ios-build-config.js",
        "native:genbindings": "node scripts/genbindings.js",
        "genbindings:sevalue": "node scripts/generate-nativevalue-to-se.js",
        "genbindings:native-tosevalue": "node scripts/generate-native-tosevalue.js",
        "test:native-bindings": "node scripts/test-native-binding-utils.js",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write \"{src,assets}/**/*.ts\"",
        "format:check": "prettier --check \"{src,assets}/**/*.ts\"",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "agora": {
        "mac": "https://download.shengwang.cn/sdk/release/Shengwang_Native_SDK_for_Mac_v4.6.2_FULL.zip",
        "ios": "https://download.shengwang.cn/sdk/release/Shengwang_Native_SDK_for_iOS_v4.6.2_FULL.zip",
        "android": "https://download.shengwang.cn/sdk/release/Shengwang_Native_SDK_for_Android_v4.6.2_FULL.zip",
        "windows": "https://download.shengwang.cn/sdk/release/Shengwang_Native_SDK_for_Windows_v4.6.2_FULL.zip"
    },
    "devDependencies": {
        "@types/node": "^16.0.1",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "agora-rtc-sdk-ng": "^4.24.3",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.2",
        "eslint-plugin-prettier": "^5.5.5",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "prettier": "^3.8.3",
        "tree-sitter": "^0.21.1",
        "tree-sitter-cpp": "^0.23.4",
        "typescript": "^4.3.4"
    },
    "panels": {
        "agora-panel": {
            "title": "i18n:agora-rtc-extension-for-cocos-creator.panel_title",
            "type": "dockable",
            "main": "dist/panels/agora-panel",
            "size": {
                "min-width": 400,
                "min-height": 300,
                "width": 500,
                "height": 500
            }
        }
    },
    "contributions": {
        "builder": "./dist/builder.js",
        "asset-db": {
            "mount": {
                "path": "./assets",
                "readonly": false
            }
        },
        "menu": [
            {
                "path": "i18n:menu.extension/Agora RTC",
                "label": "i18n:agora-rtc-extension-for-cocos-creator.open_panel",
                "message": "open-panel"
            }
        ],
        "messages": {
            "open-panel": {
                "methods": [
                    "openPanel"
                ]
            },
            "query-cocos-engine-root": {
                "methods": [
                    "query-cocos-engine-root"
                ]
            },
            "query-sdk-status": {
                "methods": [
                    "query-sdk-status"
                ]
            },
            "download-sdk": {
                "methods": [
                    "download-sdk"
                ]
            },
            "delete-all-sdks": {
                "methods": [
                    "delete-all-sdks"
                ]
            },
            "generate-native-bindings": {
                "methods": [
                    "generate-native-bindings"
                ]
            }
        }
    },
    "dependencies": {
        "vue": "^3.5.34"
    }
}
